# SerpApi (https://serpapi.com/manage-api-key). Without it, only cached searches are replayed.
SERPAPI_API_KEY=
# Max live SerpApi calls per complaint / per eval run (cache hits are free). 0 = no cap.
SERPAPI_MAX_CREDITS=12

# Gemini (google-genai SDK) for intake / extraction / drafting / critic. Optional: rule-based agents run without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# LLM_PROVIDER=none          # force the rule-based agents

# Local Qdrant (docker compose up -d). If unreachable, embedded on-disk Qdrant (data/qdrant/) is used.
QDRANT_URL=http://localhost:6333

# LoanLens checkout (sibling folder by default) - powers the loan-app route.
# LOANLENS_DIR=../Loanlens
