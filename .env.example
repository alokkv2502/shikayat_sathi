# Copy to .env and fill in. Never commit real keys.

# Required: the agents need the AI (there is no rule-based stand-in)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite
# LLM_API=generate_content          # default; "interactions" is ~3x slower per call (measured)

# Required for live search (cached responses are free)
SERPAPI_API_KEY=your-serpapi-key
SERPAPI_MAX_CREDITS=12               # live SerpApi calls allowed per complaint (0 or "none" = no cap)

# Legal index (docker compose up -d); if unreachable, an embedded on-disk Qdrant in data/qdrant is used
QDRANT_URL=http://localhost:6333

# Optional
# SAATHI_TIMING=nodes                # per-node latency log in the terminal: nodes (default) | calls | off
# LOANLENS_DIR=../Loanlens           # RBI Digital Lending App directory used for loan-app complaints
